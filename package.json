{
  "name": "cit-qr-attendance",
  "private": true,
  "version": "1.0.0",
  "description": "CIT QR Attendance System — front-camera QR check-in for school events (React + Vite + Supabase).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings src tests supabase/functions scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:functions": "npx -y deno@2 check supabase/functions/check-in/index.ts supabase/functions/register-attendee/index.ts supabase/functions/manage-scanner-users/index.ts",
    "icons": "node scripts/generate-icons.mjs",
    "samples": "node scripts/generate-sample-xlsx.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.1",
    "html5-qrcode": "^2.3.8",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "read-excel-file": "^9.3.17"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "write-excel-file": "^4.1.1"
  }
}
