# -----------------------------------------------------------------------------
# Frontend (Vite) — these values are PUBLIC and end up in the browser bundle.
# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) — or the legacy "anon" key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# NEVER put the service-role / secret key or the Power Automate secret in a
# VITE_ variable. Those live only in Supabase Edge Function secrets.

# -----------------------------------------------------------------------------
# Optional scanner tuning (defaults shown). See src/config.ts.
# -----------------------------------------------------------------------------
# QR scanning cooldown after each processed scan: 500, 800 or 1000 ms are typical.
# VITE_SCAN_COOLDOWN_MS=800
# Length of the "just checked in" flash on the newest Attendance Log row.
# VITE_SUCCESS_OVERLAY_MS=1200
# How often the scanner's Attendance Log re-syncs (other tablets, manual check-ins).
# VITE_CHECK_IN_LOG_REFRESH_MS=10000
# Duplicate / invalid / error overlay duration.
# VITE_ERROR_OVERLAY_MS=2500
# Same QR must be out of view this long before it is accepted again.
# VITE_SAME_CODE_REARM_MS=1000
# Decode attempts per second.
# VITE_SCAN_FPS=10
# Check-in request timeout.
# VITE_CHECK_IN_TIMEOUT_MS=10000
